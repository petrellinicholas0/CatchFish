# Canonical production URL, used to build Stripe Checkout's success/cancel
# redirect — deliberately not derived from request headers (see api/checkout.js).
# Falls back to VERCEL_URL, then a hardcoded production domain, if unset.
APP_URL=https://catch-fish-two.vercel.app

# Stripe (set the real values in Vercel — never commit secrets)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase (app project — distinct from any project the Vercel Supabase
# integration may have auto-provisioned)
APP_SUPABASE_URL=
APP_SUPABASE_PUBLISHABLE_KEY=
APP_SUPABASE_SECRET_KEY=

# Existing Anthropic-backed analyze route
ANTHROPIC_API_KEY=

# Google Cloud Vision API (OCR — extracts text from uploaded profile
# screenshots via api/ocr.js). Restricted to Cloud Vision API only.
GOOGLE_VISION_API_KEY=
